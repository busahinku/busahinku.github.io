---
import Layout from "../layouts/Layout.astro";
import ReadingPage from "../components/ReadingPage.astro";
import { bookNotes, noteLinks } from "../utils/book-notes";
import { type Lang } from "../i18n/translations";

const lang: Lang = "en";
const notes = noteLinks(await bookNotes(lang), lang);
---

<Layout
  title="Reading"
  description="The days I read, the books I have open, and the ones I have finished."
  lang={lang}
>
  <ReadingPage lang={lang} notes={notes} />
</Layout>
