---
import { render } from "astro:content";
import BlogPostEnhanced from "../../../layouts/BlogPostEnhanced.astro";
import type { PostNavLink } from "../../../components/blog/PostNav.astro";
import { bookNotes, noteSlug, type BookNote } from "../../../utils/book-notes";

// A note about a finished book: typeset like an article, dated by when the book was finished.
export async function getStaticPaths() {
  const notes = await bookNotes("tr");
  const link = (n?: BookNote) => n && { title: n.data.title, href: `/tr/reading/${noteSlug(n)}/` };
  return notes.map((note, i) => ({
    params: { slug: noteSlug(note) },
    props: { note, prevPost: link(notes[i + 1]), nextPost: link(notes[i - 1]) },
  }));
}

interface Props {
  note: BookNote;
  prevPost?: PostNavLink;
  nextPost?: PostNavLink;
}

const { note, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(note);
const slug = noteSlug(note);
---

<BlogPostEnhanced
  post={{ title: note.data.title, description: note.data.author, pubDate: note.data.finished, heroImage: note.data.heroImage }}
  metaDescription={note.data.description ?? `${note.data.title}, ${note.data.author}`}
  headings={headings}
  lang="tr"
  ogImage={`/og/reading/${slug}.png`}
  backUrl="/tr/reading/"
  backLabel="Okuma"
  dateLabel="Bitiş:"
  prevPost={prevPost}
  nextPost={nextPost}
>
  {note.data.cover && <img slot="lead" class="book-cover" src={note.data.cover} alt="" width="240" height="360" decoding="async" />}
  <Content />
  {
    note.data.about && (
      <details class="about-book">
        <summary>Kitap hakkında</summary>
        <div lang="en">
          {note.data.about.split("\n\n").map((para) => (
            <p>{para}</p>
          ))}
        </div>
        {note.data.aboutFromHardcover && <p class="about-credit" set:html={`Açıklama <a href="https://hardcover.app/">Hardcover</a>'dan.`} />}
      </details>
    )
  }
</BlogPostEnhanced>

<style>
  /* The book's own cover, small and upright above the title: a cover is 2:3, never the 16:10 hero. */
  .book-cover {
    display: block;
    width: 8rem;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    margin: 0 0 1.75rem;
    border-radius: 2px;
    background: var(--bg-secondary);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--text-primary) 8%, transparent);
  }

  /* The book's own description, folded away under the note: his words first, the blurb on request. */
  .about-book {
    margin: 2.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .about-book summary {
    cursor: pointer;
    color: var(--text-primary);
    font-weight: 500;
  }

  .about-credit {
    font-size: 0.8125rem;
  }

  .about-credit :global(a) {
    color: inherit;
  }

  @media (max-width: 640px) {
    .book-cover {
      width: 6.5rem;
    }
  }
</style>

