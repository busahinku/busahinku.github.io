---
import Layout from "../../layouts/Layout.astro";
import PhotoWall from "../../components/PhotoWall.astro";
import { type Lang } from "../../i18n/translations";

const lang: Lang = "tr";
---

<Layout title="Fotoğraflar" description="Çektiğim fotoğraflar, çoğu yürüyüşlerde ve uzun yollarda." lang={lang} bleed>
  {/* The pictures are the page. The heading is here for the document
      outline and for anyone arriving by screen reader, and for nobody else. */}
  <h1 class="sr-only">Fotoğraflar</h1>
  <PhotoWall lang={lang} />
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
