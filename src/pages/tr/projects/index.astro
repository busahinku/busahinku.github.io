---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import ArchiveList from "../../../components/ArchiveList.astro";
import { useTranslations, type Lang } from "../../../i18n/translations";
import {
  getProjectCover,
  getLocalizedProjects,
  getProjectSlug,
} from "../../../utils/project-localization";
import { comparePinnedThenNewest } from "../../../utils/content-sort";

const lang: Lang = "tr";
const t = useTranslations(lang);

const projects = getLocalizedProjects(
  await getCollection("projects", ({ data }) => !data.draft),
  lang,
).sort(comparePinnedThenNewest);

const items = projects.map((project) => ({
  href: `/tr/projects/${getProjectSlug(project)}/`,
  title: project.data.title,
  date: project.data.pubDate,
  description: project.data.description,
  image:
    project.data.heroImage ?? getProjectCover(getProjectSlug(project)),
  category: t(`projects.category.${project.data.category}` as any),
  meta: [
    t(`projects.category.${project.data.category}` as any),
    project.data.tags.slice(0, 4).join(", "),
  ]
    .filter(Boolean)
    .join(" · "),
}));
---

<Layout
  title={t("projects.title")}
  description={t("projects.description")}
  lang={lang}
>
  <ArchiveList
    variant="gallery"
    viewLabels={{
      group: t("archive.viewLabel"),
      grid: t("archive.viewGrid"),
      list: t("archive.viewList"),
    }}
    title={t("projects.title")}
    intro="Raporlar, uygulamalar ve çeşitli bitmişlik seviyelerinde deneyler."
    emptyNote="Henüz bir şey yok."
    searchPlaceholder={t("projects.search")}
    allLabel={t("projects.allCategories")}
    items={items}
  />
</Layout>
