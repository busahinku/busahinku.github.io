---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { type Lang } from "../../i18n/translations";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_CONFIG } from "../../consts";
import FormattedDate from "../../components/FormattedDate.astro";
import Signature from "../../components/Signature.astro";
import {
  getLocalizedProjects,
  getProjectSlug,
} from "../../utils/project-localization";

const lang: Lang = "tr";

const latestPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const latestProjects = getLocalizedProjects(
  await getCollection("projects", ({ data }) => !data.draft),
  lang,
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const links = [
  { label: "GitHub", href: SITE_CONFIG.social.github },
  { label: "LinkedIn", href: SITE_CONFIG.social.linkedin },
  { label: "X", href: SITE_CONFIG.social.twitter },
  { label: "Spotify", href: SITE_CONFIG.social.spotify },
  { label: "E-posta", href: `mailto:${SITE_CONFIG.email}` },
];
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} lang={lang}>
  <div class="home-page">
    <header class="intro">
      <h1 class="name">Burak Şahin Küçük</h1>
      <p class="intro-p">
        ODTÜ'de istatistik ve bilgisayar mühendisliği. Buradakilerin hepsi
        kendime tuttuğum notlardan çıktı: anlamak için baştan yazmak zorunda
        kaldığım dersler, saklamaya değer bulduğum raporlar,
        bitirecek kadar ilgimi çeken projeler bir de konuşmaya değerli bulduğum bazı şeyler.
      </p>
      <p class="links">
        {
          links.map((link, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">·</span>}
              <a
                href={link.href}
                target={link.href.startsWith("mailto") ? undefined : "_blank"}
                rel="noreferrer"
              >
                {link.label}
              </a>
            </>
          ))
        }
      </p>
      <Signature label="Burak Şahin Küçük" />
    </header>

    {
      latestProjects.length > 0 && (
        <section class="index-section">
          <div class="section-head">
            <h2>İşler</h2>
            <a class="all-link" href="/tr/projects">
              tümü
            </a>
          </div>
          <ol class="toc-list">
            {latestProjects.map((project) => (
              <li>
                <a class="toc-row" href={`/tr/projects/${getProjectSlug(project)}/`}>
                  <span class="toc-title">{project.data.title}</span>
                  <span class="toc-leader" aria-hidden="true" />
                  <span class="toc-meta">
                    {project.data.pubDate.getFullYear()}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="index-section">
      <div class="section-head">
        <h2>Yazılar</h2>
        {latestPosts.length > 0 && (
          <a class="all-link" href="/tr/blog">tümü</a>
        )}
      </div>
      {
        latestPosts.length > 0 ? (
          <ol class="toc-list">
            {latestPosts.map((post) => (
              <li>
                <a class="toc-row" href={`/tr/blog/${post.id}/`}>
                  <span class="toc-title">{post.data.title}</span>
                  <span class="toc-leader" aria-hidden="true" />
                  <span class="toc-meta">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty-note">Yakında.</p>
        )
      }
    </section>
  </div>
</Layout>

<style>
  .home-page {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
  }

  /* Intro. The name and the line under it are the engraved part; the
     paragraph below goes back to the reading face. */
  /* The card composition: the name centred with air around it, then the
     text under it. Everything below the rule goes back to being a list. */
  /* The opening screen is the card: name down to signature, sitting in the
     middle of the first viewport. It stops a little short of the full
     height so a sliver of Work shows underneath and people know to scroll.
     svh, not vh, so a phone's collapsing address bar does not cut it off. */
  .intro {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* symmetric, so the block reads as centred; the top half also keeps the
       text out from under the fixed header on a short screen */
    padding: 5.5rem 0;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--page-title);
    line-height: 1.25;
    letter-spacing: -0.005em;
    text-wrap: balance;
    margin: 0;
    color: var(--text-primary);
  }

  .intro-p {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 1.25rem 0 1.25rem;
    max-width: 54ch;
    /* centred text with a one-word last line reads as a mistake */
    text-wrap: balance;
  }

  .intro-p a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .intro-p a:hover {
    text-decoration-color: var(--accent);
  }

  .intro-p .read-more {
    color: var(--text-muted);
    text-decoration: none;
  }

  .intro-p .read-more:hover {
    color: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.625rem;
    align-items: baseline;
    margin: 0;
    font-size: 0.9375rem;
  }

  .links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .links a:hover {
    color: var(--accent);
  }

  .sep {
    color: var(--border);
    user-select: none;
  }

  /* Sections */
  .index-section {
    margin-top: 5rem;
  }

  /* the intro already ends on a screen boundary, so the first list does not
     need another five rems of air on top of it */
  .index-section:first-of-type {
    margin-top: 2rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 0.375rem;
  }

  .section-head h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.25rem;
    margin: 0;
  }

  .all-link {
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .all-link:hover {
    color: var(--accent);
  }

  /* Table-of-contents style lists */
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: toc;
  }

  .toc-list > li {
    border-bottom: 1px dashed
      color-mix(in srgb, var(--border) 70%, transparent);
  }

  .toc-list > li:last-child {
    border-bottom: none;
  }

  .toc-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.875rem 0;
    text-decoration: none;
    color: inherit;
  }

  .toc-row::before {
    counter-increment: toc;
    content: counter(toc, decimal-leading-zero);
    font-size: 0.75rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .toc-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    transition: color 0.2s ease;
  }

  .toc-row:hover .toc-title {
    color: var(--accent);
  }

  .toc-leader {
    flex: 1;
    border-bottom: 1px dotted var(--border);
    transform: translateY(-4px);
    min-width: 2rem;
  }

  .toc-meta {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .empty-note {
    font-size: 0.9375rem;
    color: var(--text-muted);
    font-style: italic;
    margin: 0.875rem 0 0;
  }

  @media (max-width: 640px) {
    .intro {
      padding: 5rem 0;
    }

    .index-section {
      margin-top: 3.5rem;
    }

    .toc-leader {
      display: none;
    }

    .toc-title {
      flex: 1;
      min-width: 0;
    }
  }
</style>
