---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPostEnhanced from "../../../layouts/BlogPostEnhanced.astro";
import CourseFiles from "../../../components/CourseFiles.astro";
import StudyTools from "../../../components/StudyTools.astro";
import ResumeReading from "../../../components/ResumeReading.astro";
import Callout from "../../../components/blog/Callout.astro";
import ConceptCheck from "../../../components/blog/ConceptCheck.astro";
import RandomWalk from "../../../components/blog/RandomWalk.astro";
import { useTranslations, type Lang } from "../../../i18n/translations";
import type { PostNavLink } from "../../../components/blog/PostNav.astro";
import { comparePinnedThenNewest } from "../../../utils/content-sort";

export async function getStaticPaths() {
  const courses = (
    await getCollection("courses", ({ data }) => !data.draft)
  ).sort(comparePinnedThenNewest);

  return courses.map((course, i) => ({
    params: { slug: course.id },
    props: {
      course,
      prevPost: courses[i + 1]
        ? {
            title: courses[i + 1].data.title,
            href: `/tr/courses/${courses[i + 1].id}/`,
          }
        : undefined,
      nextPost: courses[i - 1]
        ? {
            title: courses[i - 1].data.title,
            href: `/tr/courses/${courses[i - 1].id}/`,
          }
        : undefined,
    },
  }));
}

interface Props {
  course: CollectionEntry<"courses">;
  prevPost?: PostNavLink;
  nextPost?: PostNavLink;
}

const lang: Lang = "tr";
const t = useTranslations(lang);
const { course, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(course);
// The components the notes PDF also understands (scripts/course-notes.mjs).
const components = { Callout, ConceptCheck, RandomWalk };
---

<BlogPostEnhanced
  post={course.data}
  headings={headings}
  lang={lang}
  ogImage={`/og/courses/${course.id}.png`}
  backUrl="/tr/courses"
  backLabel={t("nav.courses")}
  prevPost={prevPost}
  nextPost={nextPost}
  heroAspect="16:10"
>
  <CourseFiles slot="header" slug={course.id} lang={lang} />
  <StudyTools slot="header" slug={course.id} lang={lang} />
  <ResumeReading slot="header" slug={course.id} lang={lang} />
  <Content components={components} />
</BlogPostEnhanced>
