---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPostEnhanced from "../../layouts/BlogPostEnhanced.astro";
import { useTranslations, type Lang } from "../../i18n/translations";
import type { PostNavLink } from "../../components/blog/PostNav.astro";
import {
  getProjectCover,
  getLocalizedProjects,
  getProjectSlug,
} from "../../utils/project-localization";
import { comparePinnedThenNewest } from "../../utils/content-sort";

export async function getStaticPaths() {
  const projects = getLocalizedProjects(
    await getCollection("projects", ({ data }) => !data.draft),
    "en",
  ).sort(comparePinnedThenNewest);

  return projects.map((project, i) => ({
    params: { slug: getProjectSlug(project) },
    props: {
      project,
      prevPost: projects[i + 1]
        ? {
            title: projects[i + 1].data.title,
            href: `/projects/${getProjectSlug(projects[i + 1])}/`,
          }
        : undefined,
      nextPost: projects[i - 1]
        ? {
            title: projects[i - 1].data.title,
            href: `/projects/${getProjectSlug(projects[i - 1])}/`,
          }
        : undefined,
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  prevPost?: PostNavLink;
  nextPost?: PostNavLink;
}

const lang: Lang = "en";
const t = useTranslations(lang);
const { project, prevPost, nextPost } = Astro.props;
const projectSlug = getProjectSlug(project);
const localizedProject = {
  ...project.data,
  heroImage: project.data.heroImage ?? getProjectCover(projectSlug),
};
const { Content, headings } = await render(project);
---

<BlogPostEnhanced
  post={localizedProject}
  headings={headings}
  lang={lang}
  slug={projectSlug}
  github={project.data.github}
  demo={project.data.demo}
  backUrl="/projects"
  backLabel={t("nav.projects")}
  prevPost={prevPost}
  nextPost={nextPost}
  heroAspect="16:10"
>
  <Content />
</BlogPostEnhanced>
