---
import { Download } from "@lucide/astro";
import { useTranslations, type Lang } from "../i18n/translations";
import { remoteFile } from "../utils/files";

interface Props {
  slug: string;
  lang: Lang;
}

const { slug, lang } = Astro.props;
const t = useTranslations(lang);

// Both PDFs are uploaded to R2 by `npm run notes` (see .claude/skills/course-notes);
// a course without them simply shows nothing here. Same button language as the
// "Source code / Live demo" links on project pages: the typeset copy is primary.
const files = [
  { file: "notes.pdf", label: t("courses.typeset"), primary: true },
  { file: "handwritten.pdf", label: t("courses.handwritten"), primary: false },
].flatMap(({ file, ...rest }) => {
  const remote = remoteFile(`courses/${slug}/${file}`);
  if (!remote) return [];
  const kb = remote.bytes / 1024;
  const size = kb < 1024 ? `${Math.round(kb)} KB` : `${(kb / 1024).toFixed(1)} MB`;
  return [{ href: remote.url, pages: remote.pages, size, ...rest }];
});
---

{
  files.length > 0 && (
    <div class="course-files" data-pagefind-ignore>
      {files.map(({ href, label, pages, size, primary }) => (
        <a
          class:list={["file-button", { primary }]}
          href={href}
          target="_blank"
          rel="noopener"
          title={`PDF, ${size}`}
          aria-label={[label, "PDF", pages && `${pages} ${t("courses.pages")}`, size].filter(Boolean).join(", ")}
        >
          <Download size={16} aria-hidden="true" />
          {label}
          {pages && <span class="file-pages">{`${pages} ${t("courses.pages")}`}</span>}
        </a>
      ))}
    </div>
  )
}

<style>
  .course-files {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .file-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.16s ease-out;
  }

  .file-button.primary {
    background: var(--text-primary);
    border-color: var(--text-primary);
    color: var(--bg-primary);
  }

  .file-pages {
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .file-button:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .file-button.primary:hover {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--bg-primary);
    }
  }

  .file-button:active {
    transform: scale(0.97);
  }

  /* E-ink: the filled button keeps its fill; hover is an underline. */
  :global([data-theme="eink"]) .file-button:hover {
    text-decoration: underline;
  }
</style>
