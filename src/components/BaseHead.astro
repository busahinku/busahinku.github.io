---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SITE_TITLE, SITE_CONFIG } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Public brand assets otherwise keep the same URL forever, so browsers,
// Cloudflare and social preview crawlers can continue serving an old image.
// Bump this value whenever the favicon/app icons/default OG image change.
const BRAND_ASSET_VERSION = "20260920";

// Default OG image - replace /og-image.jpg in public/ folder with your own
const {
  title,
  description,
  image = `/og-image.jpg?v=${BRAND_ASSET_VERSION}`,
} = Astro.props;

// The 404 page is served for any unmatched URL, so the path it is built
// from is not a real address: it gets no alternates and no indexing.
const is404 = Astro.url.pathname === "/404" || Astro.url.pathname === "/404/";

// hreflang alternates: strip the /tr prefix to get the shared path
const pathWithoutLang = Astro.url.pathname.replace(/^\/tr(\/|$)/, "/");
const enURL = new URL(pathWithoutLang, Astro.site);
const trURL = new URL(
  pathWithoutLang === "/" ? "/tr/" : `/tr${pathWithoutLang}`,
  Astro.site,
);

const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE_CONFIG.author,
  url: Astro.site?.toString(),
  email: `mailto:${SITE_CONFIG.email}`,
  jobTitle: "Statistics & Computer Engineering student",
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "Middle East Technical University",
  },
  sameAs: [
    SITE_CONFIG.social.github,
    SITE_CONFIG.social.linkedin,
    SITE_CONFIG.social.twitter,
  ],
});

/*
 * Content-Security-Policy (meta form; GitHub Pages cannot send headers).
 * Allowlist covers: self-hosted assets, Spotify / YouTube / Vimeo embeds,
 * Cloudflare Web Analytics, the R2 files domain, and the site's own Workers
 * (assistant, views/likes/comments) on busahin.com/api.
 * frame-ancestors and X-Frame-Options cannot be set from <meta>;
 * add those via a Cloudflare Transform Rule if desired.
 */
const csp = [
  "default-src 'self'",
  // static.cloudflareinsights.com: Cloudflare Web Analytics, which Cloudflare
  // injects at the edge and which reports back to this origin ('self').
  // 'wasm-unsafe-eval': site search (Pagefind) runs as WebAssembly.
  "script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: https:",
  // data: the build inlines KaTeX's smallest font (large delimiters) as a data URI
  "font-src 'self' data:",
  // busahin.com explicitly so the dev server can reach the live Workers
  "connect-src 'self' https://busahin.com",
  "frame-src https://open.spotify.com https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "upgrade-insecure-requests",
].join("; ");
---

<!-- Security -->
<meta http-equiv="Content-Security-Policy" content={csp} />
<meta name="referrer" content="strict-origin-when-cross-origin" />

<!-- Theme initialization script (inline to prevent FOUC) -->
<script is:inline>
  (function () {
    const THEME_COLORS = {
      light: "#ffffff",
      dark: "#0a0a0b",
      paper: "#faf8f1",
      eink: "#ffffff",
    };

    // E-readers report update: slow, and some also report monochrome. E-ink
    // tablets running full Chrome report neither, so the mode stays pickable
    // by hand in the theme menu.
    function detectTheme() {
      if (window.matchMedia("(update: slow), (monochrome)").matches) {
        return "eink";
      }
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }

    function applyTheme() {
      const theme = localStorage.getItem("theme") || detectTheme();
      document.documentElement.setAttribute("data-theme", theme);
      syncThemeColor(theme);
    }

    function syncThemeColor(theme) {
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", THEME_COLORS[theme] || "#ffffff");
    }

    applyTheme();

    // Keep the browser chrome color in sync when the toggle changes theme
    new MutationObserver(() => {
      syncThemeColor(document.documentElement.getAttribute("data-theme"));
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    // Re-apply after view transitions swap in a fresh document
    document.addEventListener("astro:after-swap", applyTheme);
  })();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<link
  rel="icon"
  type="image/svg+xml"
  href={`/favicon.svg?v=${BRAND_ASSET_VERSION}`}
/>
<link rel="icon" href={`/favicon.ico?v=${BRAND_ASSET_VERSION}`} />
<link
  rel="apple-touch-icon"
  href={`/apple-touch-icon.png?v=${BRAND_ASSET_VERSION}`}
/>
<link rel="manifest" href={`/site.webmanifest?v=${BRAND_ASSET_VERSION}`} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE}: course notes`}
  href={new URL("courses/rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Language alternates -->
{
  !is404 && (
    <>
      <link rel="alternate" hreflang="en" href={enURL} />
      <link rel="alternate" hreflang="tr" href={trURL} />
      <link rel="alternate" hreflang="x-default" href={enURL} />
    </>
  )
}
{is404 && <meta name="robots" content="noindex" />}

<!-- Local font preloads (self-hosted, no external font CDNs). Only the two
     faces every page paints with: the roman for reading, the slab for
     names and headings. Italic is fetched on demand. -->
<link
  rel="preload"
  href="/fonts/Merriweather-normal-tr.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Rokkitt.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE_TITLE} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />

<!-- Structured data -->
<script type="application/ld+json" set:html={personSchema} />

<!-- Client-side navigation keeps prefetched page changes fast. The visual
     cross-fade is disabled: even a short animation can make an already
     completed navigation feel as though it is still waiting. -->
<ClientRouter />

<script>
  import { canAnimate, coverName } from "../lib/motion";

  // A project's cover grows from its card into the page, and back. A copy of
  // the picture is flown over the live page instead of being morphed inside a
  // view transition: for as long as a transition runs, a phone shows a
  // snapshot, and Chrome-based browsers on Android (Brave, Chrome) lay it out
  // as if the toolbar were hidden, so the ask bar at the bottom dipped and
  // came back. This way the navigation itself is over in a frame.
  let flight: { name: string; from: DOMRect; src: string } | null = null;

  document.addEventListener("astro:before-preparation", (event) => {
    flight = null;
    if (!canAnimate()) return;
    // Forward the card is here and the page's cover there; back, the reverse.
    // event.from, not location: on the back button the address has already changed.
    const name = [coverName(event.to.pathname), coverName(event.from.pathname)].find((n) =>
      document.querySelector(`[data-cover="${n}"]`),
    );
    const from = name ? document.querySelector<HTMLElement>(`[data-cover="${name}"]`) : null;
    const src = from?.querySelector("img")?.currentSrc;
    const rect = from?.getBoundingClientRect();
    if (!name || !src || !rect || rect.bottom < 0 || rect.top > innerHeight) return;
    flight = { name, from: rect, src };
    // The picture it lands on must be decoded first, or it lands on an empty
    // frame; wait for it, briefly.
    const load = event.loader;
    event.loader = async () => {
      await load();
      const img = event.newDocument.querySelector<HTMLImageElement>(`[data-cover="${name}"] img`);
      if (!img) return;
      const probe = new Image();
      probe.sizes = img.sizes;
      probe.srcset = img.srcset;
      probe.src = img.src;
      await Promise.race([probe.decode().catch(() => {}), new Promise((r) => setTimeout(r, 350))]);
    };
  });

  // The new page is in place and scrolled where it belongs: fly the copy from
  // where the picture was to where it now is, with the real one hidden until
  // it lands. Both are 16:10, so a uniform scale never distorts it.
  document.addEventListener("astro:after-swap", () => {
    const trip = flight;
    flight = null;
    const target = trip && document.querySelector<HTMLElement>(`[data-cover="${trip.name}"]`);
    if (!trip || !target) return;
    const to = target.getBoundingClientRect();
    const ghost = document.createElement("img");
    ghost.src = trip.src;
    ghost.alt = "";
    ghost.className = "cover-flight";
    Object.assign(ghost.style, { left: `${to.left}px`, top: `${to.top}px`, width: `${to.width}px`, height: `${to.height}px` });
    document.body.append(ghost);
    target.style.visibility = "hidden";
    const dx = trip.from.left - to.left;
    const dy = trip.from.top - to.top;
    ghost
      .animate([{ transform: `translate(${dx}px, ${dy}px) scale(${trip.from.width / to.width})` }, { transform: "none" }], {
        duration: 320,
        easing: "cubic-bezier(0.2, 0.8, 0.2, 1)",
      })
      .finished.finally(() => {
        target.style.visibility = "";
        ghost.remove();
      });
  });

  // Images fade in as they arrive instead of popping in. Ones already there
  // (cached, or loaded first) show at once, and without JavaScript nothing changes.
  const fadeImages = () => {
    if (!canAnimate()) return;
    for (const img of document.querySelectorAll<HTMLImageElement>("main img, article img")) {
      if (img.complete) continue;
      img.classList.add("img-fade");
      const shown = () => img.classList.add("img-in");
      img.addEventListener("load", shown, { once: true });
      img.addEventListener("error", shown, { once: true });
    }
  };
  document.addEventListener("astro:page-load", fadeImages);
</script>

<style is:global>
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  /* What does move is continuity (a photo grows from its thumbnail). The
     same curve as the cover's flight: quick out of the gate, soft at the end. */
  ::view-transition-group(*) {
    animation-duration: 0.32s;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* The copy of a cover in flight between its card and its page. Under the
     header and the ask bar, above everything else. */
  .cover-flight {
    position: fixed;
    z-index: 80;
    margin: 0;
    border-radius: 0.75rem;
    object-fit: cover;
    transform-origin: 0 0;
    pointer-events: none;
  }

  /* The page itself never moves, so a navigation with nothing to morph is
     over in a frame. While a transition runs, a phone shows a snapshot laid
     out as if its toolbar were hidden; the shorter that is, the better. */
  ::view-transition-group(root) {
    animation: none;
  }


  /* A theme change: the new colours fade in over the old. */
  html.theme-fade::view-transition-new(root) {
    animation: theme-in 0.22s ease-out;
  }

  /* A named element is lifted into a layer above the whole page for the
     length of a transition, so it would show through an open menu. A theme
     change is one picture fading into another, with no names at all. */
  html.theme-fade * {
    view-transition-name: none !important;
  }

  @keyframes theme-in {
    from {
      opacity: 0;
    }
  }
</style>
