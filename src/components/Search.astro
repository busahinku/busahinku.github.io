---
import { Search as SearchIcon } from "@lucide/astro";
import type { Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Site search. Pagefind indexes the built site (`npm run build`) and searches
// it in the browser, so there is no server and nothing to pay for. Any button
// with [data-search-open] opens this dialog, as do "/" and Cmd/Ctrl+K.
// Results come from the page's own language index (Pagefind reads <html lang>).
const copy = {
  en: {
    label: "Search the site",
    placeholder: "Search notes, writing and projects",
    close: "Close search",
    hint: "Course notes, posts and projects are all searchable.",
    none: "Nothing matches",
    offline: "Search is built with the site, so it works on the published pages only.",
  },
  tr: {
    label: "Sitede ara",
    placeholder: "Notlarda, yazılarda ve projelerde ara",
    close: "Aramayı kapat",
    hint: "Ders notları, yazılar ve projelerin hepsi aranabilir.",
    none: "Eşleşen bir şey yok:",
    offline: "Arama site ile birlikte oluşturulur, bu yüzden yalnızca yayındaki sayfalarda çalışır.",
  },
}[lang];
---

<dialog class="search" data-search aria-label={copy.label} data-copy={JSON.stringify(copy)}>
  <form class="search-bar" method="dialog">
    <SearchIcon size={18} class="search-icon" aria-hidden="true" />
    <input
      type="search"
      name="q"
      placeholder={copy.placeholder}
      aria-label={copy.label}
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
    />
    <button class="search-close" type="submit" value="close" aria-label={copy.close}>
      <kbd>Esc</kbd>
    </button>
  </form>
  <div class="search-results" aria-live="polite">
    <p class="search-note">{copy.hint}</p>
  </div>
</dialog>

<script>
  type Pagefind = {
    options: (o: object) => Promise<void>;
    debouncedSearch: (q: string, o?: object, ms?: number) => Promise<{ results: { data: () => Promise<Result> }[] } | null>;
  };
  type Sub = { title: string; url: string; excerpt: string };
  type Result = { url: string; meta: { title?: string }; excerpt: string; sub_results?: Sub[] };

  let pagefind: Promise<Pagefind | null> | null = null;
  const load = () =>
    (pagefind ??= import(/* @vite-ignore */ `${"/pagefind/"}pagefind.js`)
      .then(async (pf: Pagefind) => {
        await pf.options({ excerptLength: 22 });
        return pf;
      })
      .catch(() => null));

  function initSearch() {
    const dialog = document.querySelector<HTMLDialogElement>("[data-search]");
    if (!dialog || dialog.dataset.ready) return;
    dialog.dataset.ready = "true";
    const copy = JSON.parse(dialog.dataset.copy || "{}");
    const input = dialog.querySelector<HTMLInputElement>("input")!;
    const results = dialog.querySelector<HTMLElement>(".search-results")!;

    const note = (text: string) => {
      const p = document.createElement("p");
      p.className = "search-note";
      p.textContent = text;
      results.replaceChildren(p);
    };

    const render = async (query: string) => {
      const pf = await load();
      if (!pf) return note(copy.offline);
      const found = await pf.debouncedSearch(query, {}, 120);
      if (found === null) return; // a newer keystroke took over
      if (!query.trim()) return note(copy.hint);
      const data = await Promise.all(found.results.slice(0, 8).map((r) => r.data()));
      if (!data.length) return note(`${copy.none} “${query}”`);
      const list = document.createElement("ol");
      list.className = "search-list";
      for (const r of data) {
        // Point at the section that matched when Pagefind found one.
        const sub = r.sub_results?.find((s) => s.url.includes("#")) ?? null;
        const a = document.createElement("a");
        a.href = sub?.url ?? r.url;
        const title = document.createElement("span");
        title.className = "search-title";
        title.textContent = sub && sub.title !== r.meta.title ? `${r.meta.title} · ${sub.title}` : r.meta.title || r.url;
        const excerpt = document.createElement("span");
        excerpt.className = "search-excerpt";
        // Only Pagefind's <mark> highlights are markup; escape anything else,
        // so a page that quotes HTML can never inject it here.
        excerpt.innerHTML = (sub?.excerpt ?? r.excerpt).replace(/<(?!\/?mark>)/g, "&lt;");
        a.append(title, excerpt);
        a.addEventListener("click", () => dialog.close());
        const li = document.createElement("li");
        li.append(a);
        list.append(li);
      }
      results.replaceChildren(list);
    };

    input.addEventListener("input", () => render(input.value));
    // Arrow keys walk between the input and the results.
    dialog.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
      const items = [input, ...results.querySelectorAll<HTMLElement>("a")];
      const at = items.indexOf(document.activeElement as HTMLElement);
      const next = items[Math.max(0, Math.min(items.length - 1, at + (e.key === "ArrowDown" ? 1 : -1)))];
      if (next) {
        e.preventDefault();
        next.focus();
      }
    });
    // A click on the backdrop (outside the panel) closes it.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }

  function openSearch() {
    const dialog = document.querySelector<HTMLDialogElement>("[data-search]");
    if (!dialog || dialog.open) return;
    dialog.showModal();
    load();
    dialog.querySelector("input")?.select();
  }

  // Global listeners once; the dialog itself is set up again after each swap.
  if (!(window as any).__searchKeys) {
    (window as any).__searchKeys = true;
    document.addEventListener("click", (e) => {
      if ((e.target as Element).closest?.("[data-search-open]")) openSearch();
    });
    document.addEventListener("keydown", (e) => {
      const typing = (e.target as HTMLElement).closest?.("input, textarea, select, [contenteditable]");
      if ((e.key === "k" && (e.metaKey || e.ctrlKey)) || (e.key === "/" && !typing)) {
        e.preventDefault();
        openSearch();
      }
    });
  }
  initSearch();
  document.addEventListener("astro:after-swap", initSearch);
</script>

<style>
  .search {
    width: min(560px, calc(100vw - 2rem));
    max-height: min(70vh, 640px);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-primary);
    color: var(--text-primary);
    box-shadow: 0 24px 64px -16px rgb(0 0 0 / 0.3);
    overflow: hidden;
  }

  .search[open] {
    display: flex;
    flex-direction: column;
  }

  .search::backdrop {
    background: rgb(0 0 0 / 0.32);
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0 0.625rem 0 1rem;
    border-bottom: 1px solid var(--border);
  }

  /* The field drops its own ring; the bar carries the focus instead. */
  .search-bar:focus-within {
    border-bottom-color: var(--accent);
    box-shadow: inset 0 -1px 0 var(--accent);
  }

  .search-bar :global(.search-icon) {
    flex: none;
    color: var(--text-muted);
  }

  .search-bar input {
    flex: 1;
    min-width: 0;
    height: 3.25rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text-primary);
    /* 16px keeps iOS from zooming in */
    font: 400 16px/1.3 var(--font-serif);
  }

  .search-bar input:focus {
    box-shadow: none;
  }

  .search-bar input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    flex: none;
    min-width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .search-close kbd {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    font: 500 0.6875rem/1.2 var(--font-serif);
  }

  .search-results {
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .search-results :global(.search-note) {
    margin: 0;
    padding: 1.25rem 1rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .search-results :global(.search-list) {
    list-style: none;
    margin: 0;
    padding: 0.375rem;
  }

  .search-results :global(.search-list a) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.625rem 0.75rem;
    border-radius: 9px;
    color: inherit;
    text-decoration: none;
  }

  .search-results :global(.search-list a:hover),
  .search-results :global(.search-list a:focus-visible) {
    background: var(--bg-secondary);
    outline: none;
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .search-results :global(.search-title) {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .search-results :global(.search-excerpt) {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .search-results :global(mark) {
    background: transparent;
    color: var(--accent);
    font-weight: 600;
  }

  @media (hover: none) {
    .search-close kbd {
      display: none;
    }

    .search-close::before {
      content: "✕";
      font-size: 1rem;
    }
  }

  /* E-ink: no shade, a hard frame; matches are underlined, not coloured. */
  :global([data-theme="eink"]) .search {
    box-shadow: none;
    border-color: #000000;
  }

  :global([data-theme="eink"]) .search-results :global(mark) {
    text-decoration: underline;
  }
</style>
