---
import type { Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Site search. Pagefind indexes the built site (`npm run build`) and searches
// it in the browser, so there is no server and nothing to pay for. Any button
// with [data-search-open] opens it, as do "/" and Cmd/Ctrl+K.
// It is a full page of its own rather than a floating palette: the query is set
// like a page title and the results read like the site's other lists.
const copy = {
  en: {
    label: "Search the site",
    placeholder: "Search",
    close: "Close",
    hint: "Course notes, writing and projects.",
    none: "Nothing matches",
    offline: "Search is built with the site, so it only works on the published pages.",
    kinds: { courses: "Course notes", projects: "Project", blog: "Writing", about: "About", misc: "Miscellany" },
  },
  tr: {
    label: "Sitede ara",
    placeholder: "Ara",
    close: "Kapat",
    hint: "Ders notları, yazılar ve projeler.",
    none: "Eşleşen bir şey yok:",
    offline: "Arama site ile birlikte oluşturulur, bu yüzden yalnızca yayındaki sayfalarda çalışır.",
    kinds: { courses: "Ders notları", projects: "Proje", blog: "Yazı", about: "Hakkımda", misc: "Ivır zıvır" },
  },
}[lang];
---

<dialog class="search" data-search aria-label={copy.label} data-copy={JSON.stringify(copy)}>
  <div class="search-page">
    <form class="search-head" method="dialog" role="search">
      <input
        class="search-input"
        type="search"
        name="q"
        placeholder={copy.placeholder}
        aria-label={copy.label}
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
      />
      <button class="search-close" type="submit" value="close">{copy.close}</button>
    </form>
    <div class="search-results" aria-live="polite">
      <p class="search-note">{copy.hint}</p>
    </div>
  </div>
</dialog>

<script>
  type Pagefind = {
    options: (o: object) => Promise<void>;
    debouncedSearch: (q: string, o?: object, ms?: number) => Promise<{ results: { data: () => Promise<Result> }[] } | null>;
  };
  type Sub = { title: string; url: string; excerpt: string };
  type Result = { url: string; meta: { title?: string }; excerpt: string; sub_results?: Sub[] };

  let pagefind: Promise<Pagefind | null> | null = null;
  const load = () =>
    (pagefind ??= import(/* @vite-ignore */ `${"/pagefind/"}pagefind.js`)
      .then(async (pf: Pagefind) => {
        await pf.options({ excerptLength: 22 });
        return pf;
      })
      .catch(() => null));

  function initSearch() {
    const dialog = document.querySelector<HTMLDialogElement>("[data-search]");
    if (!dialog || dialog.dataset.ready) return;
    dialog.dataset.ready = "true";
    const copy = JSON.parse(dialog.dataset.copy || "{}");
    const input = dialog.querySelector<HTMLInputElement>("input")!;
    const results = dialog.querySelector<HTMLElement>(".search-results")!;

    const note = (text: string) => {
      const p = document.createElement("p");
      p.className = "search-note";
      p.textContent = text;
      results.replaceChildren(p);
    };
    // The kind of page, read from its path: /courses/..., /tr/projects/...
    const kind = (url: string) => copy.kinds[url.replace(/^\/(tr\/)?/, "").split("/")[0]] ?? "";

    const render = async (query: string) => {
      const pf = await load();
      if (!pf) return note(copy.offline);
      const found = await pf.debouncedSearch(query, {}, 120);
      if (found === null) return; // a newer keystroke took over
      if (!query.trim()) return note(copy.hint);
      const data = await Promise.all(found.results.slice(0, 8).map((r) => r.data()));
      if (!data.length) return note(`${copy.none} “${query}”`);
      const list = document.createElement("ol");
      list.className = "search-list";
      for (const r of data) {
        // Point at the section that matched when Pagefind found one.
        const sub = r.sub_results?.find((s) => s.url.includes("#")) ?? null;
        const a = document.createElement("a");
        a.className = "search-row";
        a.href = sub?.url ?? r.url;
        const line = document.createElement("span");
        line.className = "search-line";
        const title = document.createElement("span");
        title.className = "search-title";
        title.textContent = r.meta.title || r.url;
        const leader = document.createElement("span");
        leader.className = "search-leader";
        leader.setAttribute("aria-hidden", "true");
        const meta = document.createElement("span");
        meta.className = "search-kind";
        meta.textContent = kind(r.url);
        line.append(title, leader, meta);
        const excerpt = document.createElement("span");
        excerpt.className = "search-excerpt";
        if (sub && sub.title !== r.meta.title) {
          const section = document.createElement("span");
          section.className = "search-section";
          // "What is X?" needs no colon after it.
          section.textContent = /[?!.:]$/.test(sub.title) ? `${sub.title} ` : `${sub.title}: `;
          excerpt.append(section);
        }
        // Only Pagefind's <mark> highlights are markup; escape anything else,
        // so a page that quotes HTML can never inject it here.
        excerpt.insertAdjacentHTML("beforeend", (sub?.excerpt ?? r.excerpt).replace(/<(?!\/?mark>)/g, "&lt;"));
        a.append(line, excerpt);
        a.addEventListener("click", () => dialog.close());
        const li = document.createElement("li");
        li.append(a);
        list.append(li);
      }
      results.replaceChildren(list);
    };

    input.addEventListener("input", () => render(input.value));
    // Arrow keys walk between the field and the results.
    dialog.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
      const items = [input, ...results.querySelectorAll<HTMLElement>("a")];
      const at = items.indexOf(document.activeElement as HTMLElement);
      const next = items[Math.max(0, Math.min(items.length - 1, at + (e.key === "ArrowDown" ? 1 : -1)))];
      if (next) {
        e.preventDefault();
        next.focus();
      }
    });
  }

  function openSearch() {
    const dialog = document.querySelector<HTMLDialogElement>("[data-search]");
    if (!dialog || dialog.open) return;
    dialog.showModal();
    load();
    dialog.querySelector("input")?.select();
  }

  // Global listeners once; the dialog itself is set up again after each swap.
  if (!(window as any).__searchKeys) {
    (window as any).__searchKeys = true;
    document.addEventListener("click", (e) => {
      if ((e.target as Element).closest?.("[data-search-open]")) openSearch();
    });
    document.addEventListener("keydown", (e) => {
      const typing = (e.target as HTMLElement).closest?.("input, textarea, select, [contenteditable]");
      if ((e.key === "k" && (e.metaKey || e.ctrlKey)) || (e.key === "/" && !typing)) {
        e.preventDefault();
        openSearch();
      }
    });
  }
  initSearch();
  document.addEventListener("astro:after-swap", initSearch);
</script>

<style>
  /* A page of its own: opaque, edge to edge, nothing showing through. */
  .search {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg-primary);
    color: var(--text-primary);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .search::backdrop {
    background: var(--bg-primary);
  }

  .search-page {
    max-width: 720px;
    margin: 0 auto;
    padding: max(1.25rem, env(safe-area-inset-top)) 1rem 4rem;
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
  }

  /* The page covers the screen at once (nothing shows through); only its
     contents ease in. */
  @starting-style {
    .search[open] .search-page {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (min-width: 769px) {
    .search-page {
      padding-top: 6rem;
    }
  }

  /* The query is set like a page title, on a single rule. */
  .search-head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
    background: var(--bg-primary);
    transition: border-color 0.2s ease;
  }

  .search-head:focus-within {
    border-bottom-color: var(--text-primary);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text-primary);
    /* --page-title never goes under 22px, so iOS does not zoom in */
    font: 600 var(--page-title) / 1.2 var(--font-serif);
  }

  .search-input:focus {
    box-shadow: none;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    flex: none;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .search-results :global(.search-note) {
    margin: 1.25rem 0 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  /* Results read like the homepage lists: title, dotted leader, kind. */
  .search-results :global(.search-list) {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .search-results :global(.search-list li + li) {
    border-top: 1px dashed color-mix(in srgb, var(--border) 70%, transparent);
  }

  .search-results :global(.search-row) {
    display: block;
    padding: 0.875rem 0;
    color: inherit;
    text-decoration: none;
  }

  .search-results :global(.search-line) {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .search-results :global(.search-title) {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    transition: color 0.2s ease;
  }

  .search-results :global(.search-leader) {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1px dotted var(--border);
    transform: translateY(-4px);
  }

  .search-results :global(.search-kind) {
    flex: none;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .search-results :global(.search-excerpt) {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .search-results :global(.search-section) {
    font-style: italic;
  }

  /* A match is underlined, not painted, so it survives e-ink as well. */
  .search-results :global(mark) {
    background: transparent;
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .search-close:hover,
    .search-results :global(.search-row:hover .search-title) {
      color: var(--accent);
    }
  }

  @media (max-width: 640px) {
    .search-results :global(.search-leader) {
      display: none;
    }

    .search-results :global(.search-title) {
      flex: 1;
      min-width: 0;
    }
  }
</style>
