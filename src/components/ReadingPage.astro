---
import { Flag, RotateCw } from "@lucide/astro";
import type { Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

// Live numbers from workers/reading (/api/reading/summary). The page ships
// only its headings: every block that needs data stays hidden until the data
// is there, so a failed request or no JavaScript never shows an empty chart.
const { lang } = Astro.props;
const tr = lang === "tr";
const copy = tr
  ? { title: "Okuma", year: "Yıl", now: "Şu an okuduklarım", finished: "Bitirdiklerim", less: "Az", more: "Çok", retry: "Yeniden dene", noscript: "Sayılar JavaScript ile yükleniyor." }
  : { title: "Reading", year: "The year", now: "Reading now", finished: "Finished", less: "Less", more: "More", retry: "Try again", noscript: "The numbers load with JavaScript." };
---

<div class="reading-page" data-reading={lang} data-pagefind-body>
  <header class="page-head">
    <h1>{copy.title}</h1>
    <p class="status" data-status data-pagefind-ignore aria-live="polite" hidden>
      <span data-status-text></span>
      <button class="retry" type="button" data-retry hidden><RotateCw size={14} aria-hidden="true" />{copy.retry}</button>
    </p>
    <noscript><p class="status">{copy.noscript}</p></noscript>
  </header>

  <dl class="figures" data-block hidden></dl>

  <section class="reading-section" data-block="year" hidden>
    <div class="section-head"><h2>{copy.year}</h2></div>
    <div class="year-scroll" data-scroll>
      <div class="year" data-year>
        <div class="months" data-months aria-hidden="true"></div>
        <div class="year-grid" data-grid role="img"></div>
      </div>
    </div>
    <div class="legend" aria-hidden="true">
      <span>{copy.less}</span>
      <span class="day" data-level="0"></span><span class="day" data-level="1"></span><span class="day" data-level="2"></span><span
        class="day"
        data-level="3"></span><span class="day" data-level="4"></span>
      <span>{copy.more}</span>
    </div>
  </section>

  <section class="reading-section" data-block="now" hidden>
    <div class="section-head"><h2>{copy.now}</h2></div>
    <ul class="leader-list" data-list="now"></ul>
  </section>

  <section class="reading-section" data-block="finished" hidden>
    <div class="section-head"><h2>{copy.finished}</h2></div>
    <ul class="leader-list" data-list="finished"></ul>
  </section>

  <template data-icon="flag"><Flag size={13} aria-hidden="true" /></template>
</div>

<script>
  import { canAnimate } from "../lib/motion";

  const ENDPOINT = import.meta.env.DEV ? "https://busahin.com/api/reading/summary" : "/api/reading/summary";
  const EASE = "cubic-bezier(0.2, 0.8, 0.2, 1)"; // the site's one motion curve (ArchiveList, BaseHead)

  type Book = { title: string; author: string | null; percent: number; percent_per_day: number; pages_per_day: number | null; forecast: string | null };
  type Done = { title: string; author: string | null; finished: string | null; days: number | null };
  type Summary = {
    today: string;
    updated_at: number | null;
    streak: { current: number; longest: number };
    days: [string, number][];
    reading: Book[];
    finished: Done[];
    time: { seconds: number; week_seconds: number } | null;
  };

  const text = {
    en: {
      locale: "en-GB",
      loading: "Loading…",
      failed: "Couldn't load the numbers.",
      synced: (when: string) => `Synced ${when}`,
      never: "Nothing synced yet",
      day: (n: number) => (n === 1 ? "day" : "days"),
      current: "Current streak",
      longest: "Longest streak",
      daysRead: "Days read, last 12 months",
      pages: "Pages, last 12 months",
      hours: "Hours read",
      grid: (n: number, p: number) => `Reading days over the last 12 months: ${n} days, ${p} pages.`,
      cell: (day: string, pages: number | undefined) => (pages === undefined ? day : `${day}, ${pages === 1 ? "1 page" : `${pages} pages`}`),
      perDay: (v: string, pages: boolean) => (pages ? `${v} pages a day` : `${v}% a day`),
      by: "Expected to finish",
      stalled: "No progress in two weeks",
      took: (n: number, s: string) => (n === 1 ? "1 day" : `${s} days`),
      nothingNow: "Nothing open right now.",
      nothingDone: "None yet.",
    },
    tr: {
      locale: "tr-TR",
      loading: "Yükleniyor…",
      failed: "Sayılar yüklenemedi.",
      synced: (when: string) => `Eşitleme: ${when}`,
      never: "Henüz eşitleme yok",
      day: () => "gün",
      current: "Şu anki seri",
      longest: "En uzun seri",
      daysRead: "Son 12 ayda okuduğum gün",
      pages: "Son 12 ayda okuduğum sayfa",
      hours: "Okuma saati",
      grid: (n: number, p: number) => `Son 12 ayın okuma günleri: ${n} gün, ${p} sayfa.`,
      cell: (day: string, pages: number | undefined) => (pages === undefined ? day : `${day}, ${pages} sayfa`),
      perDay: (v: string, pages: boolean) => (pages ? `günde ${v} sayfa` : `günde %${v}`),
      by: "Tahmini bitiş",
      stalled: "İki haftadır ilerleme yok",
      took: (n: number, s: string) => `${s} gün`,
      nothingNow: "Şu an açık bir kitap yok.",
      nothingDone: "Henüz yok.",
    },
  };
  type Text = (typeof text)["en"];

  const DAY_MS = 86_400_000;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, content?: string) => {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (content !== undefined) node.textContent = content;
    return node;
  };

  // A leader row: title (and author), dotted leader, value; optional bar and a quiet line under it.
  function row(title: string, sub: string | null, value: string, under?: Node[], percent?: number) {
    const li = el("li");
    const line = el("div", "leader-row");
    const t = el("span", "row-title", title);
    if (sub) t.append(el("span", "row-sub", `, ${sub}`));
    const leader = el("span", "row-leader");
    leader.setAttribute("aria-hidden", "true");
    line.append(t, leader, el("span", "row-meta", value));
    li.append(line);
    if (percent !== undefined) {
      const bar = el("span", "bar");
      bar.setAttribute("aria-hidden", "true");
      const fill = el("span");
      fill.style.transform = `scaleX(${Math.min(100, Math.max(0, percent)) / 100})`;
      bar.append(fill);
      li.append(bar);
    }
    if (under?.length) {
      const note = el("p", "row-note");
      note.append(...under);
      li.append(note);
    }
    return li;
  }

  function figure(value: string, unit: string | null, label: string) {
    const wrap = el("div", "figure");
    const dd = el("dd", "figure-value", value);
    if (unit) dd.append(el("span", "figure-unit", ` ${unit}`));
    wrap.append(el("dt", "figure-label", label), dd);
    return wrap;
  }

  function render(root: HTMLElement, data: Summary, t: Text) {
    const num = new Intl.NumberFormat(t.locale, { maximumFractionDigits: 1 });
    const thisYear = data.today.slice(0, 4);
    const fmt = (day: string, opts: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(t.locale, { ...opts, timeZone: "UTC" }).format(new Date(`${day}T12:00:00Z`));
    const date = (day: string) => fmt(day, { day: "numeric", month: "short", year: day.slice(0, 4) === thisYear ? undefined : "numeric" });
    const block = (name: string) => root.querySelector<HTMLElement>(`[data-block="${name}"]`)!;
    const list = (name: string) => root.querySelector<HTMLElement>(`[data-list="${name}"]`)!;

    // The figures.
    const today = Date.parse(`${data.today}T00:00:00Z`);
    const yearAgo = new Date(today - 364 * DAY_MS).toISOString().slice(0, 10);
    const lastYear = data.days.filter(([d]) => d >= yearAgo);
    const pagesYear = lastYear.reduce((s, [, p]) => s + p, 0);
    const figures = root.querySelector<HTMLElement>("dl.figures")!;
    figures.replaceChildren(
      figure(num.format(data.streak.current), t.day(data.streak.current), t.current),
      figure(num.format(data.streak.longest), t.day(data.streak.longest), t.longest),
      figure(num.format(lastYear.length), null, t.daysRead),
      data.time ? figure(num.format(Math.round(data.time.seconds / 3600)), null, t.hours) : figure(num.format(pagesYear), null, t.pages),
    );

    // The year: 53 weeks, Monday to Sunday down each column, ending with this week.
    const pages = new Map(data.days);
    const grid = root.querySelector<HTMLElement>("[data-grid]")!;
    const months = root.querySelector<HTMLElement>("[data-months]")!;
    grid.setAttribute("aria-label", t.grid(lastYear.length, pagesYear));
    const weekday = (new Date(today).getUTCDay() + 6) % 7;
    const start = today - (52 * 7 + weekday) * DAY_MS;
    const cells = document.createDocumentFragment();
    const labels = document.createDocumentFragment();
    for (let i = 0; i < 53 * 7; i++) {
      const at = start + i * DAY_MS;
      const day = new Date(at).toISOString().slice(0, 10);
      if (day.endsWith("-01") && i / 7 < 51) {
        const label = el("span", undefined, fmt(day, { month: "short" }));
        label.style.gridColumn = String(Math.floor(i / 7) + 1);
        labels.append(label);
      }
      const cell = el("span", "day");
      if (at > today) cell.classList.add("future");
      else {
        const p = pages.get(day);
        cell.dataset.level = p === undefined ? "0" : p < 10 ? "1" : p < 25 ? "2" : p < 50 ? "3" : "4";
        cell.title = t.cell(date(day), p);
      }
      cells.append(cell);
    }
    grid.replaceChildren(cells);
    months.replaceChildren(labels);

    // Books.
    const flag = root.querySelector<HTMLTemplateElement>('template[data-icon="flag"]')!;
    const now = list("now");
    now.replaceChildren(
      ...data.reading.map((b) => {
        const under: Node[] = [];
        if (b.percent_per_day > 0) {
          under.push(document.createTextNode(t.perDay(num.format(b.pages_per_day ?? b.percent_per_day), b.pages_per_day != null)));
          if (b.forecast) {
            const by = el("span", "forecast");
            by.title = t.by;
            by.append(flag.content.cloneNode(true), el("span", "sr-only", `${t.by}: `), document.createTextNode(date(b.forecast)));
            under.push(by);
          }
        } else under.push(document.createTextNode(t.stalled));
        return row(b.title, b.author, `${num.format(b.percent)}%`, under, b.percent);
      }),
    );
    if (!data.reading.length) now.append(el("li", "empty", t.nothingNow));

    const done = list("finished");
    done.replaceChildren(
      ...data.finished.map((b) => row(b.title, b.author, b.finished ? date(b.finished) : "", b.days ? [document.createTextNode(t.took(b.days, num.format(b.days)))] : undefined)),
    );
    if (!data.finished.length) done.append(el("li", "empty", t.nothingDone));

    const shown = [figures, ...["year", "now", "finished"].map(block)];
    for (const b of shown) b.hidden = false;
    const scroll = root.querySelector<HTMLElement>("[data-scroll]")!;
    scroll.scrollLeft = scroll.scrollWidth; // the newest weeks first on a narrow screen

    // Motion: the blocks settle in where the loading line was, and each bar
    // grows to its value once, so the eye reads progress rather than a jump.
    if (!canAnimate()) return;
    shown.forEach((b, i) =>
      b.animate([{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }], { duration: 320, delay: i * 40, easing: EASE, fill: "backwards" }),
    );
    for (const fill of root.querySelectorAll<HTMLElement>(".bar > span"))
      fill.animate([{ transform: "scaleX(0)" }, { transform: fill.style.transform }], { duration: 480, delay: 120, easing: EASE, fill: "backwards" });
  }

  function initReading() {
    const root = document.querySelector<HTMLElement>("[data-reading]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    const t = text[root.dataset.reading === "tr" ? "tr" : "en"];
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const label = root.querySelector<HTMLElement>("[data-status-text]")!;
    const retry = root.querySelector<HTMLButtonElement>("[data-retry]")!;

    const load = async () => {
      label.textContent = t.loading;
      retry.hidden = true;
      status.hidden = false;
      status.setAttribute("aria-busy", "true");
      let data: Summary;
      try {
        const res = await fetch(ENDPOINT);
        if (!res.ok) throw new Error(String(res.status));
        data = await res.json();
      } catch {
        label.textContent = t.failed;
        retry.hidden = false;
        return;
      } finally {
        status.removeAttribute("aria-busy");
      }
      render(root, data, t);
      label.textContent = data.updated_at
        ? t.synced(new Intl.DateTimeFormat(t.locale, { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Europe/Istanbul" }).format(data.updated_at * 1000))
        : t.never;
    };
    retry.addEventListener("click", load);
    load();
  }

  initReading();
  document.addEventListener("astro:after-swap", initReading);
</script>

<style>
  .reading-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 0 2rem;
    counter-reset: reading-section;
  }

  .page-head h1 {
    font-family: "Merriweather", Georgia, serif;
    font-weight: 600;
    font-size: var(--page-title);
    line-height: 1.1;
    margin: 0 0 0.5rem;
    color: var(--text-primary);
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    min-height: 1.75rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .status[hidden],
  .retry[hidden],
  [data-block][hidden] {
    display: none;
  }

  .retry {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2rem;
    padding: 0 0.75rem;
    font: inherit;
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 0.2s ease,
      transform 0.16s ease-out;
  }

  .retry:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .retry:hover {
      border-color: var(--accent);
    }
  }

  /* The four figures */
  .figures {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin: 2.5rem 0 0;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .figures :global(.figure) {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
    min-width: 0;
  }

  .figures :global(.figure-value) {
    margin: 0;
    font-family: "Merriweather", Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.5rem, 4.5vw, 2rem);
    line-height: 1.1;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .figures :global(.figure-unit) {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text-secondary);
  }

  .figures :global(.figure-label) {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--text-secondary);
  }

  .reading-section {
    margin-top: 3.5rem;
  }

  .section-head {
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.625rem;
    margin-bottom: 0.75rem;
  }

  .section-head h2 {
    font-family: "Merriweather", Georgia, serif;
    font-weight: 500;
    font-size: 1.5rem;
    margin: 0;
  }

  .section-head h2::before {
    counter-increment: reading-section;
    content: counter(reading-section, decimal-leading-zero);
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    margin-right: 0.75rem;
    vertical-align: 0.35em;
  }

  /* Leader rows, as on the misc pages */
  .leader-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .leader-list > :global(li) {
    border-bottom: 1px dashed color-mix(in srgb, var(--border) 70%, transparent);
    padding: 0.875rem 0;
  }

  .leader-list > :global(li:last-child) {
    border-bottom: none;
  }

  .leader-list :global(.leader-row) {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .leader-list :global(.row-title) {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    min-width: 0;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .leader-list :global(.row-sub) {
    font-weight: 400;
    color: var(--text-secondary);
  }

  .leader-list :global(.row-leader) {
    flex: 1;
    border-bottom: 1px dotted var(--border);
    transform: translateY(-4px);
    min-width: 2rem;
  }

  .leader-list :global(.row-meta) {
    font-size: 0.875rem;
    color: var(--text-secondary);
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .leader-list :global(.row-note) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .leader-list :global(.forecast) {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
  }

  .leader-list :global(.forecast svg) {
    flex: none;
  }

  .leader-list :global(.empty) {
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  /* Progress under a book; the percentage is in the row as text too. */
  .leader-list :global(.bar) {
    display: block;
    height: 3px;
    margin-top: 0.625rem;
    background: color-mix(in srgb, var(--border) 60%, transparent);
    border-radius: 2px;
    overflow: hidden;
  }

  .leader-list :global(.bar > span) {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
  }

  /* The year */
  .year-scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    margin-top: 1.25rem;
    padding-bottom: 0.375rem;
    scrollbar-width: thin;
  }

  .year {
    --cell: 10px;
    --gap: 2px;
    width: max-content;
  }

  .months,
  .year-grid {
    display: grid;
    grid-template-columns: repeat(53, var(--cell));
    column-gap: var(--gap);
  }

  .months {
    height: 1.125rem;
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--text-secondary);
  }

  .months :global(span) {
    grid-row: 1;
    white-space: nowrap;
  }

  .year-grid {
    grid-auto-flow: column;
    grid-template-rows: repeat(7, var(--cell));
    grid-template-columns: none;
    grid-auto-columns: var(--cell);
    gap: var(--gap);
  }

  .reading-page :global(.day) {
    width: var(--cell, 10px);
    height: var(--cell, 10px);
    border-radius: 2px;
    border: 1px solid var(--border);
  }

  .year-grid :global(.day.future) {
    visibility: hidden;
  }

  .reading-page :global(.day[data-level="1"]) {
    border-color: transparent;
    background: color-mix(in srgb, var(--accent) 30%, var(--bg-primary));
  }

  .reading-page :global(.day[data-level="2"]) {
    border-color: transparent;
    background: color-mix(in srgb, var(--accent) 52%, var(--bg-primary));
  }

  .reading-page :global(.day[data-level="3"]) {
    border-color: transparent;
    background: color-mix(in srgb, var(--accent) 75%, var(--bg-primary));
  }

  .reading-page :global(.day[data-level="4"]) {
    border-color: transparent;
    background: var(--accent);
  }

  .legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    margin-top: 0.625rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .legend span:first-child {
    margin-right: 0.375rem;
  }

  .legend span:last-child {
    margin-left: 0.375rem;
  }

  /* E-ink has no shades: a day read is a filled square, a day missed an outline. */
  :global([data-theme="eink"]) .reading-page :global(.day:not([data-level="0"])) {
    background: var(--text-primary);
  }

  :global([data-theme="eink"]) .legend .day[data-level="1"],
  :global([data-theme="eink"]) .legend .day[data-level="2"],
  :global([data-theme="eink"]) .legend .day[data-level="3"] {
    display: none;
  }

  :global([data-theme="eink"]) .leader-list :global(.bar) {
    height: 4px;
    border: 1px solid var(--text-primary);
    background: transparent;
  }

  :global([data-theme="eink"]) .leader-list :global(.bar > span) {
    background: var(--text-primary);
  }

  @media (min-width: 720px) {
    .year {
      --cell: 10.5px;
    }
  }

  @media (max-width: 640px) {
    .figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .reading-section {
      margin-top: 3rem;
    }

    .leader-list :global(.row-leader) {
      display: none;
    }

    .leader-list :global(.row-title) {
      flex: 1;
    }
  }
</style>
