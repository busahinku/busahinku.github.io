---
import { ArrowUp, X } from "@lucide/astro";
import type { Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// The bar at the bottom of the page: type a question and the surface opens
// upwards with the answer streaming in. Backed by workers/assistant, which
// only knows what is on this site.
const copy = {
  en: {
    label: "Ask about Burak, his work, or his course notes",
    placeholder: "Ask about me or my notes",
    send: "Send",
    hide: "Hide answers",
    thinking: "Writing an answer",
    empty: "I couldn't find that on the site.",
    // {n} is the latest week on the course page
    course: ["Summarize Week {n}", "Quiz me on Week {n}", "What does this course cover?"],
    site: ["Who is Burak?", "What has he built?", "Which courses have notes here?"],
    errors: {
      rate: "That was a lot of questions at once. Try again in a minute.",
      quota: "The assistant has used up today's answers. It will be back tomorrow.",
      scope: "I can only help with Burak, his site, and his course notes.",
      length: "Questions need to be between 3 and 400 characters.",
      timeout: "The answer took too long. Try again in a moment.",
      other: "No answer right now. Try again in a moment.",
    },
  },
  tr: {
    label: "Burak, işleri ya da ders notları hakkında soru sorun",
    placeholder: "Bana ya da notlarıma dair sorun",
    send: "Gönder",
    hide: "Yanıtları gizle",
    thinking: "Yanıt yazılıyor",
    empty: "Bunu sitede bulamadım.",
    course: ["{n}. haftayı özetle", "{n}. haftadan bana soru sor", "Bu ders neleri kapsıyor?"],
    site: ["Burak kimdir?", "Neler geliştirdi?", "Hangi derslerin notları var?"],
    errors: {
      rate: "Arka arkaya çok soru geldi. Bir dakika sonra yeniden deneyin.",
      quota: "Asistan bugünkü yanıt hakkını doldurdu. Yarın yeniden açılacak.",
      scope: "Yalnızca Burak, sitesi ve ders notları hakkında yardımcı olabilirim.",
      length: "Soru 3 ile 400 karakter arasında olmalı.",
      timeout: "Yanıt gecikti. Biraz sonra yeniden deneyin.",
      other: "Şu anda yanıt verilemiyor. Biraz sonra yeniden deneyin.",
    },
  },
}[lang];
---

<div class="ask" data-ask data-lang={lang} data-copy={JSON.stringify(copy)} transition:persist={`ask-${lang}`}>
  <div class="ask-surface">
    <div class="ask-flow">
      <div class="ask-flow-inner">
        <button class="ask-close" type="button" aria-label={copy.hide}><X size={16} /></button>
        <div class="ask-suggest"></div>
        <div class="ask-log" role="log" aria-live="polite"></div>
      </div>
    </div>
    <form class="ask-bar">
      <label class="sr-only" for={`ask-input-${lang}`}>{copy.label}</label>
      <input
        id={`ask-input-${lang}`}
        name="q"
        maxlength="400"
        autocomplete="off"
        enterkeyhint="send"
        placeholder={copy.placeholder}
      />
      <button class="ask-send" type="submit" aria-label={copy.send} disabled>
        <ArrowUp size={19} />
      </button>
    </form>
  </div>
</div>
<!-- room at the end of the page, so the bar never sits on the footer -->
<div class="ask-spacer" aria-hidden="true"></div>

<script>
  // Production calls its own origin; the dev server calls the live Worker.
  const ENDPOINT = import.meta.env.DEV ? "https://busahin.com/api/ask" : "/api/ask";
  const ARROW =
    '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>';

  function initAsk() {
    const ask = document.querySelector<HTMLElement>("[data-ask]");
    // the bar persists across navigations, so it is set up once
    if (!ask || ask.dataset.ready) return;
    ask.dataset.ready = "true";

    const copy = JSON.parse(ask.dataset.copy || "{}");
    const lang = ask.dataset.lang;
    const input = ask.querySelector<HTMLInputElement>("input")!;
    const send = ask.querySelector<HTMLButtonElement>(".ask-send")!;
    const log = ask.querySelector<HTMLElement>(".ask-log")!;
    const suggest = ask.querySelector<HTMLElement>(".ask-suggest")!;
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const history: { role: string; content: string }[] = [];
    let busy = false;

    // Starter questions until the first one is asked. On a course page they
    // follow its latest week; the bar persists across pages, so they are
    // rebuilt on every focus.
    const showSuggestions = () => {
      suggest.replaceChildren();
      if (log.childElementCount) return;
      const weeks = [...document.querySelectorAll(".article-content h2")]
        .map((h) => /^Week (\d+)/.exec(h.textContent?.trim() || "")?.[1])
        .filter(Boolean);
      const list: string[] = weeks.length
        ? copy.course.map((q: string) => q.replace("{n}", weeks[weeks.length - 1]!))
        : copy.site;
      for (const q of list) {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.textContent = q;
        chip.addEventListener("click", () => {
          input.value = q;
          ask.querySelector("form")!.requestSubmit();
        });
        suggest.append(chip);
      }
    };
    const open = () => {
      showSuggestions();
      if (log.childElementCount || suggest.childElementCount) ask.classList.add("open");
    };
    const close = () => ask.classList.remove("open");
    const toBottom = () => (log.scrollTop = log.scrollHeight);

    input.addEventListener("input", () => (send.disabled = busy || input.value.trim().length < 3));
    input.addEventListener("focus", open);
    ask.querySelector(".ask-close")!.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && ask.isConnected && ask.classList.contains("open")) {
        close();
        input.blur();
      }
    });
    document.addEventListener("pointerdown", (e) => {
      if (ask.isConnected && !ask.contains(e.target as Node)) close();
    });

    const bubble = (kind: string, text = "") => {
      const el = document.createElement("div");
      el.className = `ask-message ${kind}`;
      el.textContent = text;
      log.append(el);
      return el;
    };

    // Sources are pages of this site only, in the reader's language.
    const addSources = (box: HTMLElement, list: { title: string; url: string }[]) => {
      const safe = list.filter((s) => typeof s.url === "string" && /^\/[a-z0-9/_-]*(#[\w-]+)?$/.test(s.url));
      if (!safe.length) return;
      const row = document.createElement("div");
      row.className = "ask-sources";
      for (const s of safe) {
        const a = document.createElement("a");
        a.href = lang === "tr" ? `/tr${s.url}` : s.url;
        const label = document.createElement("span");
        label.textContent = s.title;
        a.append(label);
        a.insertAdjacentHTML("beforeend", ARROW);
        row.append(a);
      }
      box.append(row);
    };

    // Types the streamed text out a little at a time so it reads evenly.
    function typist(box: HTMLElement) {
      let queue = "";
      let ended = false;
      let resolve: () => void;
      const finished = new Promise<void>((r) => (resolve = r));
      const text = document.createTextNode("");
      box.replaceChildren(text);
      const step = () => {
        if (queue) {
          const take = Math.max(1, Math.ceil(queue.length / 12));
          text.data += queue.slice(0, take);
          queue = queue.slice(take);
          toBottom();
        }
        if (queue || !ended) requestAnimationFrame(step);
        else resolve();
      };
      requestAnimationFrame(step);
      return {
        add: (t: string) => (calm ? (text.data += t) : (queue += t)),
        end: () => {
          ended = true;
          return finished;
        },
      };
    }

    ask.querySelector("form")!.addEventListener("submit", async (e) => {
      e.preventDefault();
      const question = input.value.trim();
      if (busy || question.length < 3) return;
      busy = true;
      send.disabled = true;
      input.value = "";
      suggest.replaceChildren();
      bubble("visitor", question);
      const box = bubble("answer");
      box.innerHTML = `<span class="ask-dots" role="img" aria-label="${copy.thinking}"><i></i><i></i><i></i></span>`;
      ask.classList.add("open");
      toBottom();
      let sources: { title: string; url: string }[] = [];
      let cut = "";
      try {
        const res = await fetch(ENDPOINT, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ q: question, lang, page: location.pathname, history: history.slice(-4) }),
          signal: AbortSignal.timeout(30000),
        });
        if (!res.ok || !res.headers.get("content-type")?.includes("event-stream")) {
          const body = await res.json().catch(() => ({}));
          throw new Error(copy.errors[body.error] || copy.errors.other);
        }
        const reader = res.body!.getReader();
        const decoder = new TextDecoder();
        const typed = typist(box);
        let pending = "";
        for (;;) {
          const { value, done } = await reader.read();
          if (done) break;
          pending += decoder.decode(value, { stream: true });
          const parts = pending.split("\n\n");
          pending = parts.pop() || "";
          for (const part of parts) {
            const event = /^event: (.+)$/m.exec(part)?.[1] || "message";
            const data = /^data: (.*)$/m.exec(part)?.[1];
            if (data == null) continue;
            if (event === "sources") sources = JSON.parse(data);
            else if (event === "cut") cut = JSON.parse(data);
            else if (event === "message") typed.add(JSON.parse(data));
          }
        }
        await typed.end();
        if (cut) box.textContent = cut;
        else if (!box.textContent?.trim()) box.textContent = copy.empty;
        else {
          history.push({ role: "user", content: question }, { role: "assistant", content: box.textContent });
          addSources(box, sources);
        }
      } catch (error) {
        box.classList.add("error");
        box.textContent =
          (error as Error).name === "TimeoutError" ? copy.errors.timeout : (error as Error).message || copy.errors.other;
      } finally {
        busy = false;
        toBottom();
        send.disabled = input.value.trim().length < 3;
      }
    });
  }

  initAsk();
  document.addEventListener("astro:after-swap", initAsk);
</script>

<style>
  .ask {
    --ask-ease: cubic-bezier(0.32, 0.72, 0, 1);
    position: fixed;
    z-index: 90;
    left: 50%;
    bottom: max(16px, env(safe-area-inset-bottom));
    width: min(640px, calc(100vw - 24px));
    transform: translateX(-50%);
    font-family: var(--font-serif);
  }

  .ask-surface {
    background: color-mix(in srgb, var(--bg-primary) 90%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    border: 1px solid color-mix(in srgb, var(--text-primary) 11%, transparent);
    border-radius: 28px;
    box-shadow:
      0 18px 48px -12px rgb(0 0 0 / 0.26),
      0 2px 6px rgb(0 0 0 / 0.06);
    transition:
      border-radius 0.45s var(--ask-ease),
      box-shadow 0.3s;
  }

  .ask-surface:focus-within {
    box-shadow:
      0 22px 56px -12px rgb(0 0 0 / 0.32),
      0 0 0 4px color-mix(in srgb, var(--text-primary) 6%, transparent);
  }

  .ask.open .ask-surface {
    border-radius: 24px;
  }

  .ask-flow {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ask-ease);
  }

  .ask.open .ask-flow {
    grid-template-rows: 1fr;
  }

  .ask-flow-inner {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }

  .ask-log {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-height: min(56vh, 540px);
    overflow-y: auto;
    padding: 22px 22px 8px;
    scrollbar-width: thin;
    overscroll-behavior: contain;
  }

  .ask-close {
    position: absolute;
    top: 10px;
    right: 12px;
    z-index: 1;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--bg-primary) 80%, transparent);
    color: var(--text-muted);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.3s,
      background-color 0.2s,
      color 0.2s;
  }

  .ask.open .ask-close {
    opacity: 1;
  }

  .ask-close:hover {
    color: var(--text-primary);
    background: color-mix(in srgb, var(--text-primary) 7%, transparent);
  }

  .ask-log:empty {
    display: none;
  }

  .ask-suggest {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 20px 52px 4px 22px;
  }

  .ask-suggest:empty {
    display: none;
  }

  .ask-suggest :global(button) {
    padding: 7px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-secondary);
    font: 400 13.5px/1.3 var(--font-serif);
    cursor: pointer;
    animation: ask-in 0.4s var(--ask-ease) both;
    transition:
      border-color 0.2s,
      color 0.2s,
      background-color 0.2s;
  }

  .ask-suggest :global(button:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ask-suggest :global(button:nth-child(2)) {
    animation-delay: 0.04s;
  }

  .ask-suggest :global(button:nth-child(3)) {
    animation-delay: 0.08s;
  }

  .ask-log :global(.ask-message) {
    font-size: 15px;
    line-height: 1.65;
    font-weight: 380;
    color: var(--text-primary);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    animation: ask-in 0.4s var(--ask-ease) both;
  }

  .ask-log :global(.ask-message.visitor) {
    align-self: flex-end;
    max-width: 82%;
    padding: 10px 16px;
    border-radius: 20px 20px 6px 20px;
    background: color-mix(in srgb, var(--text-primary) 7%, transparent);
  }

  .ask-log :global(.ask-message.answer) {
    align-self: stretch;
    padding-right: 28px;
    color: var(--text-secondary);
  }

  .ask-log :global(.ask-message.error) {
    color: var(--text-muted);
  }

  .ask-log :global(.ask-sources) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
    white-space: normal;
  }

  .ask-log :global(.ask-sources a) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    padding: 6px 10px 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .ask-log :global(.ask-sources a span) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ask-log :global(.ask-sources a:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ask-log :global(.ask-sources svg) {
    flex: none;
  }

  .ask-log :global(.ask-dots) {
    display: inline-flex;
    gap: 5px;
    padding: 8px 0;
  }

  .ask-log :global(.ask-dots i) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-muted);
    animation: ask-dot 1.2s ease-in-out infinite;
  }

  .ask-log :global(.ask-dots i:nth-child(2)) {
    animation-delay: 0.15s;
  }

  .ask-log :global(.ask-dots i:nth-child(3)) {
    animation-delay: 0.3s;
  }

  .ask-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 56px;
    padding: 0 8px 0 22px;
  }

  .ask-bar input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text-primary);
    /* 16px keeps iOS from zooming in on focus */
    font: 380 16px/1.3 var(--font-serif);
  }

  /* the surface shows focus as a whole; global.css would also ring the field */
  .ask-bar input:focus {
    box-shadow: none;
  }

  .ask-bar input::placeholder {
    color: var(--text-muted);
  }

  .ask-send {
    flex: none;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--text-primary);
    color: var(--bg-primary);
    cursor: pointer;
    transition:
      transform 0.25s var(--ask-ease),
      opacity 0.2s;
  }

  .ask-send:hover {
    transform: scale(1.06);
  }

  .ask-send:active {
    transform: scale(0.94);
  }

  .ask-send:disabled {
    opacity: 0.28;
    cursor: default;
    transform: none;
  }

  .ask-spacer {
    height: 88px;
    flex: none;
  }

  /* on narrow screens the bar reaches the corner, so lift the back-to-top button */
  @media (max-width: 820px) {
    :global(.back-to-top) {
      bottom: calc(max(16px, env(safe-area-inset-bottom)) + 68px) !important;
      right: 1rem !important;
    }
  }

  @keyframes ask-dot {
    0%,
    60%,
    100% {
      opacity: 0.25;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  @keyframes ask-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* E-ink: no glass, no shadow; the frame carries the shape. */
  :global([data-theme="eink"]) .ask-surface {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    background: #ffffff;
    border: 1px solid #000000;
    box-shadow: none;
  }

  :global([data-theme="eink"]) .ask-log :global(.ask-sources a:hover) {
    text-decoration: underline;
  }

  @media print {
    .ask,
    .ask-spacer {
      display: none;
    }
  }
</style>
