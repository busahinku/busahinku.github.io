---
import type { Lang } from "../../i18n/translations";

interface Props {
  pageKey: string;
  lang: Lang;
}

// Comments with no sign-in. Each one waits until I have read it
// (`npm run comments`), so nothing reaches the page unseen.
const { pageKey, lang } = Astro.props;
const copy = {
  en: {
    title: "Comments",
    empty: "No comments yet.",
    name: "Name",
    optional: "optional",
    comment: "Comment",
    send: "Send",
    note: "Comments show up here once I have read them.",
    thanks: "Thank you. It will show up here once I have read it.",
    failed: "That did not go through. Please try again in a minute.",
    anonymous: "A reader",
  },
  tr: {
    title: "Yorumlar",
    empty: "Henüz yorum yok.",
    name: "Ad",
    optional: "isteğe bağlı",
    comment: "Yorum",
    send: "Gönder",
    note: "Yorumlar ben okuduktan sonra burada görünür.",
    thanks: "Teşekkürler. Okuduktan sonra burada görünecek.",
    failed: "Gönderilemedi. Bir dakika sonra tekrar dener misin?",
    anonymous: "Bir okur",
  },
}[lang];
---

<section class="comment-section" data-comments={pageKey} data-copy={JSON.stringify({ ...copy, lang })} data-pagefind-ignore>
  <h2 class="comments-title">{copy.title} <span class="comments-count" data-count></span></h2>
  <ol class="comment-list" data-list></ol>
  <p class="comment-quiet" data-empty>{copy.empty}</p>

  <form class="comment-form" data-form>
    <label class="comment-field">
      <span class="comment-label">{copy.name} <span class="comment-hint">({copy.optional})</span></span>
      <input name="name" maxlength="60" autocomplete="name" />
    </label>
    <label class="comment-field">
      <span class="comment-label">{copy.comment}</span>
      <textarea name="body" rows="4" minlength="2" maxlength="2000" required></textarea>
    </label>
    <!-- Only bots fill this in; people never see it. -->
    <input class="comment-trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="comment-actions">
      <button class="comment-send" type="submit">{copy.send}</button>
      <p class="comment-quiet" data-status role="status">{copy.note}</p>
    </div>
  </form>
</section>

<script>
  import { load, send } from "../../lib/engagement";

  function initComments() {
    const root = document.querySelector<HTMLElement>("[data-comments]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    const key = root.dataset.comments!;
    const copy = JSON.parse(root.dataset.copy || "{}");
    const list = root.querySelector<HTMLElement>("[data-list]")!;
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-empty]")!;
    const form = root.querySelector<HTMLFormElement>("[data-form]")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const date = new Intl.DateTimeFormat(copy.lang, { day: "numeric", month: "long", year: "numeric" });

    load(key).then((data) => {
      const comments = data?.comments ?? [];
      count.textContent = comments.length ? String(comments.length) : "";
      empty.hidden = comments.length > 0;
      list.replaceChildren(
        ...comments.map((c) => {
          const li = document.createElement("li");
          li.className = "comment";
          const meta = document.createElement("p");
          meta.className = "comment-meta";
          const name = document.createElement("span");
          name.className = "comment-name";
          name.textContent = c.name || copy.anonymous;
          const time = document.createElement("time");
          // D1 stores UTC as "YYYY-MM-DD HH:MM:SS".
          const when = new Date(`${c.created.replace(" ", "T")}Z`);
          time.dateTime = when.toISOString();
          time.textContent = date.format(when);
          meta.append(name, time);
          const body = document.createElement("p");
          body.className = "comment-body";
          body.textContent = c.body;
          li.append(meta, body);
          return li;
        }),
      );
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const button = form.querySelector<HTMLButtonElement>("button")!;
      const fields = Object.fromEntries(new FormData(form));
      button.disabled = true;
      const result = await send("/comment", { key, ...fields });
      button.disabled = false;
      status.textContent = result ? copy.thanks : copy.failed;
      if (result) form.reset();
    });
  }

  const schedule = () => ("requestIdleCallback" in window ? requestIdleCallback(initComments, { timeout: 2000 }) : setTimeout(initComments, 1000));
  schedule();
  document.addEventListener("astro:after-swap", schedule);
</script>

<style>
  .comment-section {
    max-width: var(--blog-content-width, 640px);
    margin: 2rem auto 0;
  }

  .comments-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-serif);
    font-size: var(--blog-h2-size);
    font-weight: 500;
    color: var(--text-primary);
  }

  .comments-count {
    color: var(--text-muted);
    font-weight: 400;
  }

  .comment-quiet {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .comment-quiet[hidden] {
    display: none;
  }

  /* Read like the site's other lists: rows on dashed rules. */
  .comment-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .comment-list :global(.comment) {
    padding: 1rem 0;
  }

  .comment-list :global(.comment + .comment) {
    border-top: 1px dashed color-mix(in srgb, var(--border) 70%, transparent);
  }

  .comment-list :global(.comment-meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0 0 0.375rem;
    font-size: 0.875rem;
  }

  .comment-list :global(.comment-name) {
    font-weight: 600;
    color: var(--text-primary);
  }

  .comment-list :global(time) {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .comment-list :global(.comment-body) {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text-secondary);
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .comment-form {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .comment-field {
    display: grid;
    gap: 0.375rem;
  }

  .comment-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .comment-hint {
    font-weight: 400;
    color: var(--text-muted);
  }

  .comment-field input,
  .comment-field textarea {
    width: 100%;
    font-family: inherit;
    line-height: 1.5;
  }

  .comment-field textarea {
    min-height: 7rem;
    resize: vertical;
  }

  .comment-trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .comment-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .comment-send {
    min-height: 2.5rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--text-primary);
    border-radius: 0.375rem;
    background: var(--text-primary);
    color: var(--bg-primary);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.16s ease-out;
  }

  .comment-send:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .comment-send:active {
    transform: scale(0.97);
  }

  .comment-actions .comment-quiet {
    flex: 1;
    min-width: 12rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .comment-send:not(:disabled):hover {
      border-color: var(--accent);
      background: var(--accent);
    }
  }
</style>
